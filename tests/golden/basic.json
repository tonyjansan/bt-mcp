{
  "desc": "initialize / tools.list / tools.call 文本结果 / ping / 未知方法",
  "steps": [
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-06-18",
          "capabilities": {},
          "clientInfo": {
            "name": "golden",
            "version": "1"
          }
        }
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
