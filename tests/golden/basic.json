            "tools": {
              "listChanged": true
            },
            "resources": {
              "subscribe": true,
              "listChanged": true
            },
            "prompts": {
              "listChanged": true
            },
            "logging": {}
          },
          "serverInfo": {
            "name": "bt-mcp-device",
            "version": "0.4"
          },
          "_meta": {
            "io.btmcp/ver": "0.4",
            "io.btmcp/chan": {
              "kind": 1,
              "mtu": 244,
              "window": 4,
              "reliable": 1,
              "flow": 1
            }
          }
        }
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "tools/list"
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "tools": [
            {
              "name": "echo",
              "description": "echo text",
