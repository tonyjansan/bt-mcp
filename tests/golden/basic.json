                "idempotentHint": true
              }
            },
            {
              "name": "restricted_tool",
              "description": "always denied",
              "inputSchema": {
                "type": "object",
                "properties": {}
              },
              "annotations": {
                "destructiveHint": true
              }
            },
            {
              "name": "rich_tool",
              "description": "multi content",
              "inputSchema": {
                "type": "object",
                "properties": {}
              }
            }
          ]
        }
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "tools/call",
        "params": {
          "name": "echo",
          "arguments": {
            "text": "hi"
          }
        }
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "content": [
            {
              "type": "text",
              "text": "hi"
            }
          ],
          "isError": false
        }
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "ping"
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {}
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "nope"
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 5,
        "error": {
          "code": -32601,
          "message": "Method not found"
        }
      }
    }
