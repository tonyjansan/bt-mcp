{
  "desc": "resources.list（含 title/size）/ resources.read 分页与不存在 / 订阅",
  "steps": [
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "initialize",
        "params": {
          "protocolVersion": "2025-06-18",
          "capabilities": {}
        }
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "protocolVersion": "2025-06-18",
          "capabilities": {
            "tools": {
              "listChanged": true
            },
            "resources": {
              "subscribe": true,
              "listChanged": true
            },
            "prompts": {
              "listChanged": true
            },
            "logging": {}
          },
          "serverInfo": {
            "name": "bt-mcp-device",
            "version": "0.5"
          },
          "_meta": {
            "io.btmcp/ver": "0.5",
            "io.btmcp/chan": {
              "kind": 1,
              "mtu": 244,
              "window": 4,
              "reliable": 1,
              "flow": 1
            }
          }
        }
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "resources/list"
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {
          "resources": [
            {
              "name": "hr_window",
              "title": "Heart rate",
              "uri": "bt-mcp://dev/hr_window",
              "description": "heart rate window",
              "mimeType": "text/plain"
            },
            {
              "name": "log",
              "uri": "bt-mcp://dev/log",
              "description": "device log",
              "mimeType": "text/plain",
              "size": 20
            }
          ]
        }
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "resources/read",
        "params": {
          "uri": "bt-mcp://dev/log"
        }
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 3,
        "result": {
          "contents": [
            {
              "uri": "bt-mcp://dev/log",
              "mimeType": "text/plain",
              "text": "01234567"
            }
          ],
          "nextCursor": "8"
        }
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "resources/read",
        "params": {
          "uri": "bt-mcp://dev/log",
          "cursor": "8"
        }
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 4,
        "result": {
          "contents": [
            {
              "uri": "bt-mcp://dev/log",
              "mimeType": "text/plain",
              "text": "89ABCDEF"
            }
          ],
          "nextCursor": "16"
        }
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "resources/read",
        "params": {
          "uri": "bt-mcp://dev/missing"
        }
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 5,
        "error": {
          "code": -32002,
          "message": "Resource not found"
        }
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "resources/subscribe",
        "params": {
          "uri": "bt-mcp://dev/log"
        }
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 6,
        "result": {}
      }
    },
    {
      "req": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "resources/unsubscribe",
        "params": {
          "uri": "bt-mcp://dev/log"
        }
      },
      "expect": {
        "jsonrpc": "2.0",
        "id": 7,
        "result": {}
      }
    }
  ]
}
